{
  "name": "queryhost",
  "version": "0.0.0",
  "description": "Fast, typed game server queries for TypeScript.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "queryhost": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts",
    "query": "npm run build --silent && node dist/cli.js",
    "test": "vitest run",
    "test:types": "npm run build && tsd",
    "test:package": "npm run build && node scripts/verify-package.ts && publint && attw --pack . --profile esm-only",
    "typecheck": "tsc --project tsconfig.check.json",
    "verify": "npm run format:check && npm run build && npm run typecheck && npm run lint && npm run test && npm run test:types && npm run test:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@foxglove/wasm-bz2": "^0.3.0"
  }
}
