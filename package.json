{
  "name": "queryhost",
  "version": "1.0.0",
  "description": "Fast, typed game server queries for TypeScript.",
  "keywords": [
    "game-server",
    "minecraft",
    "source-query",
    "typescript"
  ],
  "homepage": "https://query.host/",
  "bugs": {
    "url": "https://github.com/xIGBClutchIx/queryhost/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xIGBClutchIx/queryhost.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "queryhost": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && node node_modules/@typescript/native/bin/tsc --project tsconfig.build.json",
    "docs:api": "typedoc --options typedoc.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --report-unused-disable-directives src test test-d",
    "query": "npm run build --silent && node dist/cli.js",
    "release:check": "node scripts/release-check.mjs",
    "test": "vitest run",
    "test:types": "npm run build && tsd",
    "test:package": "npm run build && publint && attw --pack . --profile esm-only && node scripts/package-smoke.mjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --project tsconfig.check.json",
    "verify": "npm run format:check && npm run release:check && npm run build && npm run docs:api && npm run typecheck && npm run lint && npm run test && tsd && publint && attw --pack . --profile esm-only && node scripts/package-smoke.mjs",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.10.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-check": "4.9.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsd": "^0.33.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@foxglove/wasm-bz2": "^0.3.0"
  }
}
